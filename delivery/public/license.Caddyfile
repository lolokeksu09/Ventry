# Owner-approved opt-in: append to the existing site Caddyfile in a verified
# checkout. Do not publish until DNS, TLS and deploy persistence are established.
license.ventrylab.top {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @client {
        method POST
        path /api/v1/download /api/v1/activate /api/v1/entitlement
    }
    handle @client {
        request_body {
            max_size 2KB
        }
        reverse_proxy ventry-public-gateway:18090 {
            header_up X-Ventry-Client-IP {http.request.remote.host}
        }
    }
    @static {
        method GET HEAD
        path /download /download.js /style.css
    }
    handle @static {
        reverse_proxy ventry-public-gateway:18090 {
            header_up X-Ventry-Client-IP {http.request.remote.host}
        }
    }
    handle {
        header Cache-Control "no-store"
        respond 404
    }
}
