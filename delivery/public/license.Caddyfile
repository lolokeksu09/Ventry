# Public licensing only. APK delivery remains closed until signed candidate acceptance.
license.ventrylab.top {
    header {
        -Server
        Strict-Transport-Security "max-age=604800"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cache-Control "no-store"
    }
    @client {
        method POST
        path /api/v1/activate /api/v1/entitlement
    }
    handle @client {
        request_body {
            max_size 2KB
        }
        reverse_proxy ventry-public-gateway:18090 {
            header_up X-Ventry-Client-IP {http.request.remote.host}
        }
    }
    @cloud_read {
        method POST
        path /api/v1/backups/list /api/v1/backups/1/read /api/v1/backups/2/read /api/v1/backups/3/read
    }
    handle @cloud_read {
        request_body {
            max_size 2KB
        }
        reverse_proxy ventry-public-gateway:18090 {
            header_up X-Ventry-Client-IP {http.request.remote.host}
        }
    }
    @cloud_put {
        method POST
        path /api/v1/backups/1/put /api/v1/backups/2/put /api/v1/backups/3/put
    }
    handle @cloud_put {
        request_body {
            max_size 16777216
        }
        reverse_proxy ventry-public-gateway:18090 {
            header_up X-Ventry-Client-IP {http.request.remote.host}
        }
    }
    handle {
        respond 404
    }
}
