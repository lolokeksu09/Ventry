FROM rust:1.94.0-bookworm AS build
WORKDIR /src
COPY delivery/service/Cargo.toml delivery/service/Cargo.lock ./
COPY delivery/service/src ./src
COPY delivery/service/web ./web
COPY delivery/service/release.json ./
RUN cargo build --release --locked

FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates openjdk-17-jre-headless apksigner aapt \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/ventry-delivery /usr/local/bin/ventry-delivery
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/ventry-delivery"]
