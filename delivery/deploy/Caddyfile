{
    admin off
    auto_https off
    servers {
        protocols h1 h2
        timeouts {
            read_body 75s
            read_header 5s
            write 110s
            idle 30s
        }
    }
}

https://:18443 {
    tls /run/delivery/server.pem /run/delivery/server-key.pem
    header -Server
    @admin path / /admin.js /style.css /api/v1/session /api/v1/session/logout /api/v1/projects /api/v1/projects/* /api/v1/customers/* /api/v1/plans /api/v1/release /api/v1/subscriptions /api/v1/subscriptions/*
    handle @admin {
        request_body {
            max_size 8KB
        }
        reverse_proxy 127.0.0.1:18081
    }
    handle {
        respond 404
    }
}

https://:18444 {
    tls /run/delivery/server.pem /run/delivery/server-key.pem
    header -Server
    @static {
        method GET HEAD
        path /download /download.js /style.css
    }
    handle @static {
        reverse_proxy 127.0.0.1:18082
    }
    @client {
        method POST
        path /api/v1/download /api/v1/activate /api/v1/entitlement
    }
    handle @client {
        request_body {
            max_size 2KB
        }
        reverse_proxy 127.0.0.1:18082
    }
    @cloud_read {
        method POST
        path /api/v1/backups/list /api/v1/backups/1/read /api/v1/backups/2/read /api/v1/backups/3/read
    }
    handle @cloud_read {
        request_body {
            max_size 2KB
        }
        reverse_proxy 127.0.0.1:18082
    }
    @cloud_put {
        method POST
        path /api/v1/backups/1/put /api/v1/backups/2/put /api/v1/backups/3/put
    }
    handle @cloud_put {
        request_body {
            max_size 16777216
        }
        reverse_proxy 127.0.0.1:18082
    }
    handle {
        respond 404
    }
}
