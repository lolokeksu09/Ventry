# Pin both the primary brand domain and the existing temporary host.
# Do not depend on /opt/ventry/.env: deployment deliberately leaves it untouched.
ventrylab.top, 135-106-227-179.sslip.io {
    root * /srv
    encode zstd gzip

    # A static presentation never needs write methods or cross-origin preflights.
    @nonread not method GET HEAD
    header @nonread Allow "GET, HEAD"
    respond @nonread 405

    @health path /healthz
    header @health Cache-Control "no-store"
    respond @health "ok" 200

    # Deny dotfiles, VCS metadata, credentials, database dumps and backups,
    # even if a file is accidentally copied into the published site directory.
    @sensitive path_regexp (?i)(?:^|/)(?:\.[^/]+|[^/]+\.(?:bak|backup|old|orig|swp|sql|sqlite|db|dump|zip|tar|tgz|gz|7z|pem|key|p12|pfx))(?:/|$)
    respond @sensitive 404


    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=604800"
        # This site has no inline scripts/styles or external asset origins.
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }

    # Revalidate HTML so a new deployment cannot reuse an old document with new assets.
    @pages path / */ *.html
    header @pages Cache-Control "no-cache"

    @assets path *.css *.js *.svg
    header @assets Cache-Control "public, max-age=0, must-revalidate"

    # Cache only the two explicitly approved, unchanged font files for one hour.
    @fonts path /fonts/golos-cyrillic.woff2 /fonts/golos-latin.woff2
    header @fonts Cache-Control "public, max-age=3600, must-revalidate"

    @release path /version.json
    header @release Cache-Control "no-store"

    # Explicit publication manifest. New public files must be deliberately listed.
    # The CI source guard keeps this list in sync with site/.
    @unpublished not path / /about /about/ /about/index.html /app.js /approach /approach/ /approach/index.html /brand.css /company-nav.js /contact /contact/ /contact/index.html /docs /docs/ /docs/index.html /explore /explore/ /explore/index.html /favicon.svg /fonts/OFL.txt /fonts/golos-cyrillic.woff2 /fonts/golos-latin.woff2 /google9048871eda96ab4a.html /home-company.css /images/raschet-icon.svg /images/raschet-ledger-small.webp /images/raschet-ledger.webp /images/raschet/android-book.webp /images/raschet/android-client-statistics.webp /images/raschet/android-statistics.webp /images/ventry-glass-mobile.webp /images/ventry-glass.webp /images/ventry-mark-large.webp /images/ventry-mark.webp /index.html /inner-pages.css /legal /legal/ /legal/index.html /og-cover.png /og-cover.svg /privacy /privacy/ /privacy/index.html /projects /projects/ /projects/index.html /projects/raschet /projects/raschet/ /projects/raschet/index.html /raschet /raschet-cover.jpg /raschet/ /raschet/app.js /raschet/backup-encryption.js /raschet/backups.js /raschet/book-storage.js /raschet/demo-analytics.js /raschet/history.js /raschet/index.html /raschet/ledger.js /raschet/style.css /releases /releases/ /releases/index.html /robots.txt /sitemap.xml /status /status/ /status/index.html /styles.css /support /support/ /support/index.html /ventry-brand-cover.jpg /ventry-company-cover.png /version.json
    header @unpublished Cache-Control "no-store"
    respond @unpublished 404

    file_server
}

# Preserve the original IP redirect target and existing legacy URLs.
http://135.106.227.179 {
    header -Server
    redir https://135-106-227-179.sslip.io{uri} 308
}

# Public licensing only. APK delivery remains closed until signed candidate acceptance.
license.ventrylab.top {
    header {
        -Server
        Strict-Transport-Security "max-age=604800"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cache-Control "no-store"
    }
    @client {
        method POST
        path /api/v1/activate /api/v1/entitlement
    }
    handle @client {
        request_body {
            max_size 2KB
        }
        reverse_proxy ventry-public-gateway:18090 {
            header_up X-Ventry-Client-IP {http.request.remote.host}
        }
    }
    handle {
        respond 404
    }
}
